{
  "name": "greencode-server",
  "version": "2.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
  "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
  "build": "prisma generate && tsc",
  "start": "cross-env NODE_ENV=production node dist/server.js",
  "prisma:generate": "prisma generate",
  "prisma:migrate": "prisma migrate dev",
  "prisma:seed": "tsx prisma/seed.ts",
  "prisma:studio": "prisma studio",
  "setup": "npm install && prisma migrate dev && tsx prisma/seed.ts"
},
  "dependencies": {
    "@fastify/env": "^5.0.2",
    "@fastify/jwt": "^10.2.5",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/client": "^6.4.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.13.4",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
